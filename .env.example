# Copy to .env and fill in the starred (*) values:  cp .env.example .env
# Connection strings for Postgres/RabbitMQ/Redis/S3 are set in docker-compose.yml
# for the containers; the values here are used when running services on the host.

# ---- Gateway ----------------------------------------------------------------
GATEWAY_BASE_URL=http://localhost:8000
ADMIN_TOKEN=change-me-admin-token
# Optional: enables the fast, reliable submit-time 20-minute check.
YOUTUBE_API_KEY=
METADATA_TIMEOUT_SEC=3

# ---- LLM (*) ----------------------------------------------------------------
# anthropic | openai | gemini | fake (fake = offline deterministic, for tests only)
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=claude-haiku-5-5
# Only for OpenAI-compatible endpoints other than api.openai.com
LLM_BASE_URL=
# Configure ~80% of your provider's real limits so a burst never gets a 429.
LLM_RPM=10
LLM_TPM=200000
LLM_MAX_OUTPUT_TOKENS=16000

# ---- Notion (*) --------------------------------------------------------------
# Public integration (OAuth). Redirect URI is fixed by the key in extension/manifest.json.
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=https://odkinkapbnndcekhonhigbeaoclbecfj.chromiumapp.org/
NOTION_VERSION=2022-06-28
NOTION_RPS=2.5
# Blank -> the template page duplicated during OAuth (sent by the extension);
# if that is also missing -> the most recently edited page shared with the integration.
DEFAULT_NOTION_PARENT_ID=

# ---- Broker / state / storage (*) ---------------------------------------------
# S3 credentials must match infra/s3/s3.json (the SeaweedFS identity).
RABBITMQ_URL=amqp://vn:vn@localhost:5672/
DATABASE_URL=postgresql+asyncpg://vn:vn@localhost:5432/vn
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=vidnotes

# ---- Rate limits ----------------------------------------------------------------
YOUTUBE_RPS=2
RL_MAX_WAIT_SEC=60

# ---- Retries (*) ------------------------------------------------------------------
MAX_ATTEMPTS=5
# Default backoff. Demo profile (five attempts in ~75 s): RETRY_DELAYS=5,10,20,40
RETRY_DELAYS=10,30,90,180

# ---- Pipeline -----------------------------------------------------------------------
MAX_DURATION_SEC=1200
MAX_FRAMES=8
CHUNK_TOKENS=6000
FRAME_PARALLELISM=3
FRAME_BEST_OF=3
FRAME_TIMEOUT_SEC=30
# Optional residential proxy if YouTube blocks your IP (http://user:pass@host:port)
YT_PROXY_URL=

# ---- Security (*) ---------------------------------------------------------------------
# Fernet key shared by gateway and workers; encrypts the Notion token in queue messages.
# DEV KEY ONLY - generate your own:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENC_KEY=rWmxadaZGwJHYedXewTnEp5Z7k7_eWj5zzghuKXZFiE=

# ---- Demo / chaos (leave blank in normal runs) ------------------------------------------
# e.g. llm:0.3,notion:0.2,youtube:0.1
FAULT_INJECT_429=
# probability 0..1 that a frame capture fails
FAULT_INJECT_FRAME_FAIL=
LOG_LEVEL=INFO
